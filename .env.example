# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
RING_USERNAME=
RING_PASSWORD=

# Pushover (prototype notifications)
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# APNs (production Apple Watch notifications)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_DEVICE_TOKENS=

# Shared secret for API writes (watch device registration, --post pipeline).
# Generate one: python3 -c 'import secrets; print(secrets.token_hex(24))'
ANIMAL_TRACKER_API_TOKEN=
